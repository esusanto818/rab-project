+--
+-- Name: fn_check_project_payment_items_within_header(); Type: FUNCTION; Schema: public; Owner: -
+--
+
+CREATE FUNCTION public.fn_check_project_payment_items_within_header() RETURNS trigger
+    LANGUAGE plpgsql
+    AS $$
+DECLARE
+    v_total      numeric(18,2);
+    v_allocated  numeric(18,2);
+BEGIN
+    SELECT COALESCE(total_amount, 0) INTO v_total
+      FROM public.project_payments
+     WHERE id = NEW.payment_id;
+
+    SELECT COALESCE(SUM(amount_paid), 0) INTO v_allocated
+      FROM public.project_payment_items
+     WHERE payment_id = NEW.payment_id;
+
+    IF v_allocated > v_total + 0.01 THEN
+        RAISE EXCEPTION 'Project payment item allocation (%.2F) exceeds payment total (%.2F)',
+                        v_allocated, v_total;
+    END IF;
+    RETURN NEW;
+END;
+$$;
+
+
+--
+-- Name: fn_check_project_payment_within_invoice(); Type: FUNCTION; Schema: public; Owner: -
+--
+
+CREATE FUNCTION public.fn_check_project_payment_within_invoice() RETURNS trigger
+    LANGUAGE plpgsql
+    AS $$
+DECLARE
+    v_balance numeric(18,2);
+BEGIN
+    SELECT COALESCE(amount,0)
+         - COALESCE(paid_amount,0)
+         - COALESCE(retention_amount,0)
+      INTO v_balance
+      FROM public.project_invoices
+     WHERE id = NEW.invoice_id;
+
+    IF v_balance < 0 THEN
+        v_balance := 0;
+    END IF;
+
+    IF NEW.amount_paid > v_balance + 0.01 THEN
+        RAISE EXCEPTION 'Project payment allocation (%.2F) exceeds invoice balance (%.2F)',
+                        NEW.amount_paid, v_balance;
+    END IF;
+    RETURN NEW;
+END;
+$$;
+
+
+--
+-- Name: fn_check_spk_task_material_alloc(); Type: FUNCTION; Schema: public; Owner: -
+--
+
+CREATE FUNCTION public.fn_check_spk_task_material_alloc() RETURNS trigger
+    LANGUAGE plpgsql
+    AS $$
+DECLARE
+    v_task_qty numeric(18,4);
+BEGIN
+    SELECT COALESCE(tm.qty_budget, 0) INTO v_task_qty
+      FROM public.task_materials tm
+     WHERE tm.id = NEW.task_material_id AND tm.active;
+
+    IF v_task_qty <= 0 THEN
+        RAISE EXCEPTION 'No active task_materials allocation found for task_material_id = % (spk_task_materials qty = %.4F)',
+                        NEW.task_material_id, NEW.qty;
+    END IF;
+
+    IF NEW.qty > v_task_qty + 0.001 THEN
+        RAISE EXCEPTION 'spk_task_materials qty (%.4F) exceeds task material allocation (%.4F)',
+                        NEW.qty, v_task_qty;
+    END IF;
+    RETURN NEW;
+END;
+$$;
+
+
