+    IF NEW.qty_certified > v_passed + 0.001 THEN
+        RAISE EXCEPTION 'subcon_payment_certificate_items qty_certified (%.4F) exceeds passed qty (%.4F)',
+                        NEW.qty_certified, v_passed;
+    END IF;
+    RETURN NEW;
+END;
+$$;
