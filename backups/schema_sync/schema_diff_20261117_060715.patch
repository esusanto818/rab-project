+
+CREATE VIEW public.v_project_actual_cost AS
+ WITH iss AS (
+         SELECT h.project_id,
+            sum((i.qty_out * i.unit_cost)) AS cost_material
+           FROM (public.material_out_header h
+             JOIN public.material_out_items i ON ((i.material_out_id = h.id)))
+          WHERE (((h.status)::text = 'posted'::text) AND (h.reversed_at IS NULL) AND ((COALESCE(h.issue_type, 'PROJECT'::character varying))::text = 'PROJECT'::text))
+          GROUP BY h.project_id
+        ), oth AS (
+         SELECT e.project_id,
+            sum(e.amount) AS cost_expense
+           FROM public.financial_expenses e
+          WHERE ((e.project_id IS NOT NULL) AND (upper((COALESCE(e.status, ''::character varying))::text) <> ALL (ARRAY['VOID'::text, 'CANCELLED'::text, 'CANCELED'::text, 'BATAL'::text, 'DIBATALKAN'::text])))
+          GROUP BY e.project_id
+        ), sub_cert AS (
+         SELECT sc.project_id,
+            sum(spc.gross_amount) AS cost_subcon
+           FROM (((public.subcon_payment_certificates spc
+             JOIN public.subcon_inspections si ON ((si.id = spc.inspection_id)))
+             JOIN public.subcon_progress sp ON ((sp.id = si.progress_id)))
+             JOIN public.subcon_contracts sc ON ((sc.id = sp.contract_id)))
+          WHERE ((spc.status)::text = 'APPROVED'::text)
+          GROUP BY sc.project_id
+        ), sub_fallback AS (
+         SELECT sc.project_id,
+            sum(sp.gross_amount) AS cost_subcon
+           FROM (public.subcon_progress sp
+             JOIN public.subcon_contracts sc ON ((sc.id = sp.contract_id)))
+          WHERE ((sp.status)::text = 'Disetujui'::text)
+          GROUP BY sc.project_id
+        ), wip AS (
+         SELECT r.project_id,
+            sum(r.amount) AS hpp_released
+           FROM public.project_wip_release r
+          GROUP BY r.project_id
+        )
+ SELECT p.id AS project_id,
+    p.name AS project_name,
+    p.status AS project_status,
+    COALESCE((p.progress)::integer, 0) AS progress,
+    (COALESCE(p.budget, (0)::numeric) * COALESCE(NULLIF(p.budget_exch_rate, (0)::numeric), (1)::numeric)) AS budget_base_raw,
+    COALESCE(NULLIF((p.budget * COALESCE(NULLIF(p.budget_exch_rate, (0)::numeric), (1)::numeric)), (0)::numeric), ( SELECT COALESCE(sum((b.qty_plan * b.unit_price_plan)), (0)::numeric) AS "coalesce"
+           FROM public.budget_items b
+          WHERE (b.project_id = p.id)), (0)::numeric) AS rab_budget,
+    (COALESCE(iss.cost_material, (0)::numeric))::numeric(18,2) AS cost_material,
+    (COALESCE(oth.cost_expense, (0)::numeric))::numeric(18,2) AS cost_expense,
+    (COALESCE(sub_cert.cost_subcon, sub_fallback.cost_subcon, (0)::numeric))::numeric(18,2) AS cost_subcon,
+    (((COALESCE(iss.cost_material, (0)::numeric) + COALESCE(oth.cost_expense, (0)::numeric)) + COALESCE(sub_cert.cost_subcon, sub_fallback.cost_subcon, (0)::numeric)))::numeric(18,2) AS cost_total,
+    (COALESCE(wip.hpp_released, (0)::numeric))::numeric(18,2) AS hpp_released,
+    (GREATEST((COALESCE(iss.cost_material, (0)::numeric) - COALESCE(wip.hpp_released, (0)::numeric)), (0)::numeric))::numeric(18,2) AS wip_remaining
+   FROM (((((public.projects p
+     LEFT JOIN iss ON ((iss.project_id = p.id)))
+     LEFT JOIN oth ON ((oth.project_id = p.id)))
+     LEFT JOIN sub_cert ON ((sub_cert.project_id = p.id)))
+     LEFT JOIN sub_fallback ON ((sub_fallback.project_id = p.id)))
+     LEFT JOIN wip ON ((wip.project_id = p.id)));
+
