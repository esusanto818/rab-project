+-- Name: fn_block_journal_for_closed_period(); Type: FUNCTION; Schema: public; Owner: -
+--
+
+CREATE FUNCTION public.fn_block_journal_for_closed_period() RETURNS trigger
+    LANGUAGE plpgsql
+    AS $$
+BEGIN
+    IF (SELECT is_closed
+        FROM public.accounting_periods
+        WHERE id = NEW.period_id) THEN
+        RAISE EXCEPTION 'Cannot post journal for a closed accounting period (period_id = %)',
+                        NEW.period_id;
+    END IF;
+    RETURN NEW;
+END;
+$$;
+
+
+--
+-- Name: fn_block_journallines_for_closed_period(); Type: FUNCTION; Schema: public; Owner: -
+--
+
+CREATE FUNCTION public.fn_block_journallines_for_closed_period() RETURNS trigger
+    LANGUAGE plpgsql
+    AS $$
+DECLARE
+    v_period_id integer;
+BEGIN
+    SELECT je.period_id INTO v_period_id
+      FROM public.journal_entries je
+     WHERE je.id = NEW.journal_id;
+
+    IF v_period_id IS NOT NULL AND
+       (SELECT is_closed FROM public.accounting_periods WHERE id = v_period_id) THEN
+        RAISE EXCEPTION 'Cannot post journal_line for a journal whose accounting period is closed (period_id = %)',
+                        v_period_id;
+    END IF;
+    RETURN NEW;
+END;
+$$;
+
