+    LANGUAGE plpgsql
+    AS $$
+DECLARE
+    v_total   numeric(18,2);
+    v_allocated numeric(18,2);
+BEGIN
+    SELECT COALESCE(total_amount, 0) INTO v_total
+      FROM public.purchase_invoice_hdr
+     WHERE id = NEW.invoice_id;
+
+    SELECT COALESCE(SUM(amount_paid), 0) INTO v_allocated
+      FROM public.supplier_payment_items
+     WHERE invoice_id = NEW.invoice_id;
+
+    IF v_allocated > v_total + 0.01 THEN
+        RAISE EXCEPTION 'Supplier payment allocation (%.2F) exceeds invoice total (%.2F)',
+                        v_allocated, v_total;
+    END IF;
+    RETURN NEW;
+END;
+$$;
+
+
+--
+-- Name: fn_check_task_material_category(); Type: FUNCTION; Schema: public; Owner: -
+--
+
+CREATE FUNCTION public.fn_check_task_material_category() RETURNS trigger
+    LANGUAGE plpgsql
+    AS $$
+BEGIN
+    IF NEW.budget_item_id IS NOT NULL THEN
+        PERFORM id
+          FROM public.budget_items
+         WHERE id = NEW.budget_item_id
+           AND category <> 'Material';
+        IF FOUND THEN
+            RAISE EXCEPTION 'task_materials can only reference budget_items with category = Material (budget_item_id = %)',
+                            NEW.budget_item_id;
+        END IF;
+    END IF;
+    RETURN NEW;
+END;
+$$;
