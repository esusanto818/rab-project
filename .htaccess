RewriteEngine On
RewriteBase /rab-project/dev/

# 1. Jika ada request yang terlanjur minta /router.php, alihkan (301) ke /router (pretty URL)
RewriteCond %{THE_REQUEST} \s/rab-project/dev/router\.php[?\s] [NC]
RewriteRule ^router\.php$ /rab-project/dev/router [R=301,L,QSA]

# 2. Pemetaan internal: mengarahkan /router ke router.php secara transparan
RewriteRule ^router$ router.php [L,QSA]

# 3. Jika request ditujukan langsung ke /php/router.php, alihkan ke /router
RewriteCond %{REQUEST_URI} ^/rab-project/dev/php/router\.php [NC]
RewriteRule ^php/router\.php$ /rab-project/dev/router [R=301,L,QSA]

# 4. Kecualikan file & folder fisik asli
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 5. Arahkan sisa request non-fisik lainnya ke router.php utama
RewriteRule ^(.*)$ router.php [QSA,L]