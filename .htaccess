
RewriteEngine On
RewriteBase /rab-project/dev/

# Matikan directory listing dan blokir artefak pengembangan/backup/database yang bukan konten aplikasi.
Options -Indexes
RewriteRule ^(?:\.git|database|sql|docs|dev|live|backup[^/]*|rab-project_security_patch_review)(?:/|$) - [F,END,NC]
RewriteRule \.(?:sql|md|patch|bak|old|orig|txt|zip|code-workspace|py|sh|log|env)$ - [F,END,NC]

# A0. Jangan layani file backup, patch, workspace, dump, atau konfigurasi dari folder endpoint.
RewriteRule ^php-crud/(?:db_connection\.PHP|.*\.(?:bak|old|orig|patch|txt|code-workspace|sql|md|zip|log|env))$ - [F,END,NC]

# A1. Endpoint legacy yang tidak lagi menjadi jalur resmi; tolak eksplisit.
RewriteRule ^php-crud/(?:grnCRD_err(?:00)?|whrcvCRD_err|inventory\.status)\.php$ - [F,END,NC]

# A. Endpoint CRUD dan PDF melalui router
RewriteRule ^(php-crud|pdf)/([A-Za-z0-9_.-]+\.php)$ router.php [END,QSA,NC]

# B. Router utama
RewriteRule ^router$ router.php [END,QSA]

# C. Legacy menu router
RewriteRule ^views/router$ router.php [END,QSA,NC]

# D. Dashboard sementara diizinkan langsung
RewriteRule ^views/dashboard\.php$ - [END,NC]

# E. Sementara jangan blokir views sampai
# semua pemanggilan langsung sudah dipindahkan
# RewriteRule ^views/ - [F,END,NC]

# E. Bukti foto progres hanya boleh diakses melalui endpoint photo yang memeriksa sesi login
RewriteRule ^uploads/progress(/|$) - [F,END,NC]

# F. File dan folder fisik lainnya
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]

# G. Fallback
RewriteRule ^ router.php [END,QSA]
